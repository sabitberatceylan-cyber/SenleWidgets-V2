<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dialogColorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Renk Seçici"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Seçili Renk Önizleme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:strokeWidth="2dp"
                app:strokeColor="#FFFFFF">

                <View
                    android:id="@+id/viewColorPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EF4444" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvHexPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#EF4444"
                    android:textColor="#F8FAFC"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seçilen HEX Kodu"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hızlı Palet -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hızlı Renk Seçimi"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/presetColorsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- RGB Sliders -->
        <TextView
            android:id="@+id/tvLabelR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kırmızı (R): 239"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="239"
            android:progressTint="#EF4444"
            android:thumbTint="#EF4444"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvLabelG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeşil (G): 68"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbGreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="68"
            android:progressTint="#10B981"
            android:thumbTint="#10B981"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvLabelB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mavi (B): 68"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="68"
            android:progressTint="#3B82F6"
            android:thumbTint="#3B82F6"
            android:layout_marginBottom="16dp" />

        <!-- Manuel HEX -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="HEX Kodu Girin (#RRGGBB)"
            app:boxStrokeColor="#6366F1"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogHex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F8FAFC"
                android:text="#EF4444" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Butonlar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelColor"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İptal"
                android:textColor="#94A3B8"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rengi Uygula"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6366F1"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
